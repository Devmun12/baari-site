# Copy these names into Vercel (Project > Settings > Environment Variables).
# Never put real values in this file or in index.html.

# Required
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional
# Gemini model to use. Default: gemini-3.5-flash-lite
# Fallback if that ever fails: gemini-3.1-flash-lite
# Avoid 2.5 models: Google only serves them to people who used them before,
# so a brand-new key may be refused.
GEMINI_MODEL=
# Any long random text. Used to scramble IP addresses before storing them.
# If empty, the Supabase key is used as the salt.
IP_HASH_SALT=
